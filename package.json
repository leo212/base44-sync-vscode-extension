{
  "name": "base44-sync",
  "displayName": "Base44 Application Code Sync for VSCode",
  "publisher": "LiorTamam",
  "repository": {
    "type": "git",
    "url": "https://github.com/leo212/base44-sync-vscode-extension.git"
  },
  "description": "Sync project files between local project and base44 project",
  "version": "0.0.9",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "base44Container",
          "title": "Base44",
          "icon": "$(cloud-upload)"
        }
      ]
    },
    "views": {
      "base44Container": [
        {
          "type": "webview",
          "id": "base44Sidebar",
          "name": "Base44 Sync"
        },
        {
          "id": "base44ChangedFiles",
          "name": "Changed Files",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.deploy",
        "title": "Base44: Deploy Current File"
      },
      {
        "command": "extension.deployAll",
        "title": "Base44: Deploy All Opened Editors"
      },
      {
        "command": "extension.pull",
        "title": "Base44: Pull Remote Changes"
      },
      {
        "command": "extension.login",
        "title": "Base44: Login"
      },
      {
        "command": "extension.checkSync",
        "title": "Base44: Check Sync Status"
      },
      {
        "command": "extension.syncStatus",
        "title": "Sync Status",
        "icon": "$(sync)"
      },
      {
        "command": "extension.openChangedFileDiff",
        "title": "Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "extension.pushChangedFileFromTree",
        "title": "Push File",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "extension.revertChangedFileFromTree",
        "title": "Revert",
        "icon": "$(history)"
      },
      {
        "command": "extension.ignoreChangedFileFromTree",
        "title": "Ignore File",
        "icon": "$(eye-closed)"
      },
      {
        "command": "extension.pushAllChangedFiles",
        "title": "Push All Changes",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extension.syncStatus",
          "when": "view == base44ChangedFiles",
          "group": "navigation"
        },
        {
          "command": "extension.pushAllChangedFiles",
          "when": "view == base44ChangedFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "extension.openChangedFileDiff",
          "when": "view == base44ChangedFiles && viewItem == base44ChangedFile",
          "group": "inline"
        },
        {
          "command": "extension.pushChangedFileFromTree",
          "when": "view == base44ChangedFiles && viewItem == base44ChangedFile",
          "group": "inline"
        },
        {
          "command": "extension.revertChangedFileFromTree",
          "when": "view == base44ChangedFiles && viewItem == base44ChangedFile",
          "group": "inline"
        },
        {
          "command": "extension.ignoreChangedFileFromTree",
          "when": "view == base44ChangedFiles && viewItem == base44ChangedFile",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Base44 Sync",
      "properties": {
        "base44-sync.appId": {
          "type": "string",
          "default": "YOUR_APPLICATION_ID_FROM_BASE44",
          "description": "Your Base44 Application ID."
        },
        "base44-sync.token": {
          "type": "string",
          "default": "YOUR_AUTHENTICATION_TOKEN_FROM_BASE44",
          "description": "Your Base44 Authentication Token."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "puppeteer-core": "^24.40.0"
  }
}
